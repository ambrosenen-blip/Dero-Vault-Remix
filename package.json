{
  "name": "dero-vault",
  "productName": "Dero Vault",
  "private": true,
  "version": "1.0.0",
  "description": "Your digital granary. Simple, local-first automatic backup application. Plug in. Back up. Get on with your work.",
  "homepage": "https://github.com/Dero-Vault/Dero-Vault",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dero-Vault/Dero-Vault.git"
  },
  "author": {
    "name": "Dero Vault",
    "email": "ambrosenen@gmail.com"
  },
  "desktopName": "Dero Vault",
  "type": "module",
  "main": "windows/electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist-server/server.cjs --external:electron --external:vite --external:koffi --external:@koromix/* && esbuild server.ts --bundle --platform=node --target=node18 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist-server/server.mjs --external:electron --external:vite --external:koffi --external:@koromix/*",
    "build:frontend": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist-server/server.cjs --external:electron --external:vite --external:koffi --external:@koromix/* && esbuild server.ts --bundle --platform=node --target=node18 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist-server/server.mjs --external:electron --external:vite --external:koffi --external:@koromix/*",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:win": "electron-builder --win --x64 --publish never",
    "package:mac": "electron-builder --mac --publish never",
    "package:linux": "electron-builder --linux --publish never",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server release",
    "lint": "tsc --noEmit",
    "test:reconciliation": "tsx scripts/test-reconciliation-suite.ts",
    "test:capacity": "tsx scripts/test-capacity-safety.ts",
    "test:unified": "tsx scripts/test-unified-status-recovery-payload.ts",
    "test:isolation": "tsx scripts/test-capacity-profile-drive-isolation.ts",
    "test:integrity": "tsx scripts/test-backup-integrity-remediation.ts",
    "payload:prepare": "tsx scripts/prepare-recovery-payload.ts",
    "test": "tsx scripts/test-reconciliation-suite.ts && tsx scripts/test-rescue-migration.ts && tsx scripts/test-startup-patrol.ts && tsx scripts/test-capacity-safety.ts && tsx scripts/test-unified-status-recovery-payload.ts && tsx scripts/test-capacity-profile-drive-isolation.ts && tsx scripts/test-backup-integrity-remediation.ts"
  },
  "build": {
    "appId": "com.derovault.app",
    "productName": "Dero Vault",
    "copyright": "Copyright © 2026 Dero Vault",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "windows/**/*",
      "legal/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "windows/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "license": "windows/assets/license.rtf",
      "include": "windows/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dero Vault",
      "artifactName": "DeroVault-Setup.${ext}",
      "differentialPackage": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "windows/assets/icon.icns",
      "artifactName": "DeroVault-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "icon": "windows/assets/icon.png",
      "artifactName": "DeroVault-${version}-linux.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "koffi": "^3.3.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "lightningcss": "1.33.0"
  },
  "optionalDependencies": {
    "@typescript/typescript-win32-x64": "7.0.2",
    "@typescript/typescript-win32-arm64": "7.0.2",
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-darwin-x64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2",
    "@typescript/typescript-linux-arm64": "7.0.2",
    "@rolldown/binding-win32-x64-msvc": "1.2.12",
    "@rolldown/binding-win32-arm64-msvc": "1.2.12",
    "@rolldown/binding-darwin-arm64": "1.2.12",
    "@rolldown/binding-darwin-x64": "1.2.12",
    "@rolldown/binding-linux-x64-gnu": "1.2.12",
    "@rolldown/binding-linux-arm64-gnu": "1.2.12",
    "lightningcss-win32-x64-msvc": "1.33.0",
    "lightningcss-win32-arm64-msvc": "1.33.0",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-darwin-x64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-arm64-gnu": "1.33.0",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "@tailwindcss/oxide-win32-arm64-msvc": "4.3.3",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@esbuild/win32-x64": "0.28.2",
    "@esbuild/win32-arm64": "0.28.2",
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/darwin-x64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@esbuild/linux-arm64": "0.28.2"
  }
}
